
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Root profile (Pointers)
    match /players_v11/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      
      match /heroes/{heroId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /fanclub/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /tournaments/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // Pyramidal League Structure
    match /leagues_v2/{leagueId}/divisions/{divId}/groups/{groupId}/teams/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      
      match /heroes/{heroId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /fanclub/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // Global Matches (READ ONLY for clients)
    match /matches_v1/{matchId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    // Market & Auctions
    match /market_v7/{agentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Notifications
    match /notifications_v7/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Social & Messaging
    match /global_chat_v2/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{msgId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
    }

    match /friend_requests_v4/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /friendly_lobbies_v3/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /cw_basket_v2/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
