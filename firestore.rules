
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. ПРОФИЛИ ИГРОКОВ: Читать могут все, писать - только владелец
    match /players_v14/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Разрешаем удаление авторизованным для системного сброса (Nuclear Reset)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 2. СИСТЕМНЫЕ ДАННЫЕ (Матчи и Таблицы): Доступно авторизованным для Server Actions
    match /matches_v2/{matchId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }
    
    match /league_tables_v2/{tableId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /market_v7/{agentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 3. СОЦИАЛЬНЫЕ ФУНКЦИИ
    match /global_chat_v2/{msgId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    match /friend_requests_v4/{reqId} {
      allow read: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow write: if request.auth != null && (request.resource.data.fromId == request.auth.uid || resource.data.fromId == request.auth.uid);
    }
    
    match /private_messages_v3/{msgId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
    }

    // 4. ТЕХНИЧЕСКИЕ КОЛЛЕКЦИИ (Сброс и Инициализация)
    match /system_v1/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /cw_basket_v2/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || resource.data.matchedWithId == request.auth.uid);
    }

    // Запрет доступа ко всем остальным коллекциям по умолчанию
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
