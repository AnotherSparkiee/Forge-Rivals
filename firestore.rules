rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Упрощенные правила для обеспечения работоспособности всех систем прототипа
    // Разрешаем чтение и запись авторизованным пользователям для всех игровых коллекций
    
    match /players_v5/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /associations_v1/{assocId} {
      allow read, write: if request.auth != null;
    }
    
    match /market_v2/{agentId} {
      allow read, write: if request.auth != null;
    }
    
    match /friendly_lobbies/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /cw_basket/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /global_chat/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    match /private_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}