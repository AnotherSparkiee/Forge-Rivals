rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Правила для коллекции заявок в друзья
    match /friend_requests_v1/{requestId} {
      // Создать может любой авторизованный, если он указывает свой ID как отправителя
      allow create: if request.auth != null && request.resource.data.fromId == request.auth.uid;
      
      // Читать, обновлять и удалять могут только участники сделки (отправитель или получатель)
      allow read, update, delete: if request.auth != null && (
        resource.data.fromId == request.auth.uid || 
        resource.data.toId == request.auth.uid
      );
    }

    // Глобальные правила для остальных коллекций (в целях разработки)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}