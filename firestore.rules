
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /players_v2/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /friendly_lobbies/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        request.auth.uid == resource.data.challengerId ||
        request.resource.data.status == 'challenged'
      );
    }

    match /global_chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /private_messages/{messageId} {
      // Позволяем чтение, если пользователь является отправителем или получателем
      // Используем явное разделение на get и list для лучшей работы индексов правил
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      
      // Создание разрешено только от своего имени
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      
      // Обновление (например, пометка "прочитано") разрешено только получателю
      allow update: if isSignedIn() && resource.data.receiverId == request.auth.uid;
      
      allow delete: if false;
    }

    // Запрет по умолчанию для всего остального
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
