rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ПОЛНЫЙ ДОСТУП ДЛЯ ПРОТОТИПА
    // Позволяет всем пользователям читать и записывать любые данные.
    // Это необходимо для корректной работы AutoMatchManager, который создает общие календари и таблицы.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}