rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global rule for the prototype: Allow all authenticated users to read and write to all collections.
    // This ensures that complex world-building operations (displacing bots, generating calendars) 
    // never fail due to permission depth issues.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}