
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Main Player Profiles & Sub-collections
    match /players_v10/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // League Match Records
    match /leagues_v2/{leagueId}/matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Global Chat & Messages
    match /global_chat_v2/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{messageId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow write: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants || request.auth.uid in request.resource.data.participants);
    }

    // Social & Market
    match /friend_requests_v4/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notifications_v7/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /market_v7/{docId} {
      allow read, write: if isSignedIn();
    }

    match /cw_basket_v2/{docId} {
      allow read, write: if isSignedIn();
    }

    match /friendly_lobbies_v3/{docId} {
      allow read, write: if isSignedIn();
    }

    // Associations
    match /associations_v4/{docId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
