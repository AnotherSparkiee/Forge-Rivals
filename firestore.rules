rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. ПРИОРИТЕТ: ТРАНСФЕРНЫЙ РЫНОК (market_v2)
    // Разрешаем любые операции всем авторизованным пользователям для стабильной работы списков
    match /market_v2/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 2. ПРОФИЛИ ИГРОКОВ (players_v5)
    match /players_v5/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /players_v5 {
      allow list: if request.auth != null;
    }

    // 3. ДРУЖЕСТВЕННЫЕ МАТЧИ И ЛОББИ
    match /friendly_lobbies/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /friendly_lobbies {
      allow list: if request.auth != null;
    }

    // 4. КВ КОРЗИНА
    match /cw_basket/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /cw_basket {
      allow list: if request.auth != null;
    }

    // 5. ЧАТЫ
    match /global_chat/{messageId} {
      allow read, create: if request.auth != null;
    }

    match /private_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Запрет по умолчанию для всего остального
    match /{document=**} {
      allow read, write: if false;
    }
  }
}