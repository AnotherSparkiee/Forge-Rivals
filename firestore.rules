
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSystem() {
      // Только запросы через Admin SDK или с флагом admin в токене
      return request.auth != null && request.auth.token.admin == true;
    }

    // БЛОКИРОВКА ПРЯМОЙ ЗАПИСИ ДЛЯ КЛИЕНТОВ (Server-Authoritative Only)
    match /players_v14/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    match /matches_v2/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    match /league_tables_v2/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_slots_v1/{slotId} {
      allow read: if false; // Скрываем свободные слоты от парсинга
      allow write: if false;
    }

    match /market_v7/{agentId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /system_v1/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // РАЗРЕШЕННЫЕ КЛИЕНТСКИЕ КОЛЛЕКЦИИ (Социальный слой)
    match /global_chat_v2/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    match /friend_requests_v4/{reqId} {
      allow read, write: if request.auth != null;
    }

    match /private_messages_v3/{msgId} {
      allow read, write: if request.auth != null;
    }

    // БЕЗОПАСНЫЙ CATCH-ALL ДЛЯ СИСТЕМЫ
    match /{allPaths=**} {
      allow read, write: if isSystem();
    }
  }
}
