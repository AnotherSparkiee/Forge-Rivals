rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL TRANSFER MARKET (CRITICAL PRIORITY)
    // Shared collection where all managers compete for the same players
    match /market_v2/{agentId} {
      allow read, write: if request.auth != null;
    }

    // 2. PLAYER PROFILES (players_v5)
    match /players_v5/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /players_v5 {
      allow list: if request.auth != null;
    }

    // 3. OTHER GAME COLLECTIONS
    match /friendly_lobbies/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /friendly_lobbies {
      allow list: if request.auth != null;
    }

    match /cw_basket/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /cw_basket {
      allow list: if request.auth != null;
    }

    match /global_chat/{messageId} {
      allow read, create: if request.auth != null;
    }

    match /private_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}