rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === HELPERS ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // === DATA STRUCTURES ===

    // Root profile (Pointers & Callsigns)
    match /players_v10/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // New Atomic League Tables
    match /league_tables/{tableId} {
      allow read, write: if isSignedIn();
    }

    // New Atomic Cup Structure
    match /cup_pyramid/{cupId} {
      allow read, write: if isSignedIn();
    }

    // New Atomic Matches (v32)
    match /matches/{matchId} {
      allow read, write: if isSignedIn();
    }

    // Pyramidal League Structure (Legacy & Reference)
    match /leagues_v2/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }

    // Global Matches (Shared collection for all leagues)
    match /matches_v1/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }

    // Cup Matches (Global tournament bracket)
    match /cup_matches/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // System Status & Metadata
    match /system_v1/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Market & Auctions
    match /market_v7/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Notifications
    match /notifications_v7/{notifId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Social & Messaging
    match /global_chat_v2/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{msgId} {
      allow read, create, update: if isSignedIn() && (request.auth.uid in request.resource.data.participants || request.auth.uid in resource.data.participants);
    }

    match /friend_requests_v4/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /friendly_lobbies_v3/{lobbyId} {
      allow read, write: if isSignedIn();
    }

    match /cw_basket_v2/{entryId} {
      allow read, write: if isSignedIn();
    }

    // Fallback security
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}