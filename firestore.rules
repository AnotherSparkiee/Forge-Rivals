rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальное разрешение для прототипа. 
    // Разрешаем любые операции чтения и записи всем авторизованным пользователям для обеспечения работы трансферов и ассоциаций.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}