rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Явные правила для коллекции заявок в друзья
    match /friend_requests_v1/{requestId} {
      allow read, write, delete: if true;
    }
    // Глобальные правила для остальных коллекций
    match /{document=**} {
      allow read, write, delete: if true;
    }
  }
}