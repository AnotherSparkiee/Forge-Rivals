rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. ТРАНСФЕРНЫЙ РЫНОК (market_v2)
    // Максимально простые правила для гарантированного доступа
    match /market_v2/{agentId} {
      allow read, write: if request.auth != null;
    }

    // 2. ПРОФИЛИ ИГРОКОВ (players_v5)
    match /players_v5/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. ДРУЖЕСКИЕ МАТЧИ И ЛОББИ
    match /friendly_lobbies/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
    }

    // 4. КВ КОРЗИНА
    match /cw_basket/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
    }

    // 5. ЧАТЫ
    match /global_chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /private_messages/{messageId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && (request.auth.uid in request.resource.data.participants);
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow delete: if false;
    }

    // Запрет доступа ко всему остальному по умолчанию
    match /{document=**} {
      allow read, write: if false;
    }
  }
}