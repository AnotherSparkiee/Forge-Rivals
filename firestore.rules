
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /players_v2/{userId} {
      // Allow read for everyone to see rankings and profiles
      allow read: if true;
      // Allow write only by the owner
      allow write: if isOwner(userId);
    }

    match /friendly_lobbies/{userId} {
      // Lobbies require being signed in to see, but owner to manage
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      // Update allowed for owner or for a challenger to send a challenge
      allow update: if isOwner(userId) 
                    || (isSignedIn() && request.resource.data.status == 'challenged');
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
