rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальное разрешение для прототипа.
    // Позволяет любые операции чтения и записи любому пользователю.
    // Это гарантирует отсутствие ошибок "Missing or insufficient permissions".
    match /{document=**} {
      allow read, write: if true;
    }
  }
}