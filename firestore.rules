rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. TRANSFER MARKET (market_v2) - High Priority
    // Open access for all authenticated users to prevent permission-denied during list/get
    match /market_v2/{agentId} {
      allow read, write: if request.auth != null;
    }
    
    match /market_v2/{agentId=**} {
      allow read, write: if request.auth != null;
    }

    // 2. PLAYER PROFILES (players_v5)
    match /players_v5/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. FRIENDLY MATCHES & LOBBIES
    match /friendly_lobbies/{userId} {
      allow read, write: if request.auth != null;
    }

    // 4. CW BASKET
    match /cw_basket/{userId} {
      allow read, write: if request.auth != null;
    }

    // 5. CHATS
    match /global_chat/{messageId} {
      allow read, create: if request.auth != null;
    }

    match /private_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}