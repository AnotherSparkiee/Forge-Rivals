
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSystem() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // БЛОКИРОВКА ПРЯМОЙ ЗАПИСИ ДЛЯ КЛИЕНТОВ (Server-Authoritative Only)
    match /players_v14/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSystem());
      allow write: if isSystem(); 
    }

    match /matches_v2/{matchId} {
      allow read: if request.auth != null;
      allow write: if isSystem();
    }
    
    match /league_tables_v2/{tableId} {
      allow read: if request.auth != null;
      allow write: if isSystem();
    }

    match /league_slots_v1/{slotId} {
      allow read: if isSystem();
      allow write: if isSystem();
    }

    match /market_v7/{agentId} {
      allow read: if true;
      allow write: if isSystem();
    }
    
    match /system_v1/{docId} {
      allow read: if request.auth != null;
      allow write: if isSystem();
    }

    // БЕЗОПАСНЫЙ CATCH-ALL
    match /{allPaths=**} {
      allow read, write: if isSystem();
    }
  }
}
