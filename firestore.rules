rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === HELPERS ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // === DATA STRUCTURES ===

    // Root profile
    match /players_v10/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Season System v1
    match /league_tables_v1/{tableId} {
      allow read, write: if isSignedIn();
    }

    match /cup_pyramid_v1/{cupId} {
      allow read, write: if isSignedIn();
    }

    match /matches_v1/{matchId} {
      allow read, write: if isSignedIn();
    }

    // Leagues Hierarchy
    match /leagues_v2/{leagueId}/divisions/{divId}/groups/{groupId}/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Social & Market
    match /global_chat_v2/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{msgId} {
      allow read, create, update: if isSignedIn() && (request.auth.uid in request.resource.data.participants || request.auth.uid in resource.data.participants);
    }

    match /market_v7/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /notifications_v7/{notifId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /friendly_lobbies_v3/{lobbyId} {
      allow read, write: if isSignedIn();
    }

    match /cw_basket_v2/{entryId} {
      allow read, write: if isSignedIn();
    }

    // Fallback
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}