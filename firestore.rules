rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальное разрешение для всех коллекций и документов
    // ВНИМАНИЕ: Используется для прототипирования. В продакшене требуется ограничить доступ.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}