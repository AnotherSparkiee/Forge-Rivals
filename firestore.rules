rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. ТРАНСФЕРНЫЙ РЫНОК (market_v2)
    // Разрешаем полный доступ любому авторизованному пользователю.
    // Это гарантирует работу метода 'list' для отображения списков игроков.
    match /market_v2/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 2. ПРОФИЛИ ИГРОКОВ (players_v5)
    match /players_v5/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. ДРУЖЕСКИЕ МАТЧИ И ЛОББИ
    match /friendly_lobbies/{userId} {
      allow read, write: if request.auth != null;
    }

    // 4. КВ КОРЗИНА
    match /cw_basket/{userId} {
      allow read, write: if request.auth != null;
    }

    // 5. ЧАТЫ
    match /global_chat/{messageId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /private_messages/{messageId} {
      allow read, write: if request.auth != null;
      allow delete: if false;
    }

    // Запрет всего остального по умолчанию
    match /{document=**} {
      allow read, write: if false;
    }
  }
}