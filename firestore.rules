
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /players_v2/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /friendly_lobbies/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        request.auth.uid == resource.data.challengerId ||
        request.resource.data.status == 'challenged'
      );
    }

    match /global_chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /private_messages/{messageId} {
      // Simple and robust rule: only participants can read
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      // Only participants can create, and sender must be the current user
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      
      // Only participants can update (e.g., mark as read)
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
