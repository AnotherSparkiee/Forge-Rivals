rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Радикально открытые правила для прототипа:
    // Разрешаем любые операции всем пользователям, чтобы исключить Permission Errors
    // в распределенных системах (рынок, ассоциации, чаты).
    match /{document=**} {
      allow read, write: if true;
    }
  }
}