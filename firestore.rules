rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // В прототипе разрешаем полный доступ для всех операций.
    // Это критически важно для обеспечения работы MMO-механик (генерация календарей за ботов, инъекция игроков),
    // где один клиент может инициировать создание общих данных для всей группы.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}