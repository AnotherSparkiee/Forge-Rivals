rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальное разрешение для прототипа: 
    // Любой авторизованный пользователь может читать и писать во все коллекции.
    // Это устраняет ошибки FirestorePermissionError при создании ассоциаций и ставках на трансферах.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}