rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Хелпер для проверки системного доступа через Custom Claim
    function isSystem() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 0. ПУБЛИЧНЫЕ КОДЫ ВЕРИФИКАЦИИ (Полностью закрыты)
    match /verification_codes/{email} {
      allow read, write: if false;
    }

    // 1. ПРОФИЛИ ИГРОКОВ (v14)
    match /players_v14/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isSystem();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isSystem();
    }

    // 2. СИСТЕМНЫЕ ДАННЫЕ (Лига и Матчи)
    match /matches_v2/{matchId} {
      allow read: if request.auth != null;
      allow write: if isSystem();
    }
    
    match /league_tables_v2/{tableId} {
      allow read: if request.auth != null;
      allow write: if isSystem();
    }

    match /market_v7/{agentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if (request.auth != null && resource.data.sellerId == request.auth.uid) || isSystem(); 
    }
    
    // 3. СОЦИАЛЬНЫЕ ФУНКЦИИ
    match /global_chat_v2/{msgId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    match /friend_requests_v4/{reqId} {
      allow read: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }
    
    match /private_messages_v3/{msgId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
    }

    // 4. ТЕХНИЧЕСКИЕ КОЛЛЕКЦИИ
    match /system_v1/{docId} {
      allow read: if request.auth != null;
      allow write: if isSystem();
    }
    
    match /cw_basket_v2/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isSystem());
    }

    // БЕЗОПАСНЫЙ CATCH-ALL
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}