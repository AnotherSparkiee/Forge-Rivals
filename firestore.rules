rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Явный доступ к коллекциям рынка и игроков для устранения Access Denied
    match /market_v2/{agentId} {
      allow read, write: if true;
    }
    match /players_v5/{userId} {
      allow read, write: if true;
    }
    match /private_messages/{msgId} {
      allow read, write: if true;
    }
    match /global_chat/{msgId} {
      allow read, write: if true;
    }
    match /friendly_lobbies/{lobbyId} {
      allow read, write: if true;
    }
    match /cw_basket/{userId} {
      allow read, write: if true;
    }
    match /associations_v1/{assocId} {
      allow read, write: if true;
    }
    // Общий доступ для остальных путей
    match /{document=**} {
      allow read, write: if true;
    }
  }
}