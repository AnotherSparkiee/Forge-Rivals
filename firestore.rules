
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Moba Tactics Online Security Rules - V2
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /players_v2/{userId} {
      // Разрешаем чтение профиля владельцу
      allow get: if isOwner(userId);
      
      // Разрешаем листинг для поиска по названию команды и распределения по лигам
      allow list: if true; 
      
      // Создание: пользователь должен быть владельцем и ID должен совпадать
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      
      // Обновление: только владелец может менять свой профиль
      allow update: if isOwner(userId);
      
      // Удаление: только владелец
      allow delete: if isOwner(userId);
    }

    match /heroes/{heroId} {
      allow get, list: if true;
      allow create, update, delete: if false; // Только через админку (в будущем)
    }

    match /roles_admin/{userId} {
      allow get, list, create, update, delete: if false;
    }
  }
}
