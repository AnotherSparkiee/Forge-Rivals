rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальный доступ для прототипа
    match /{document=**} {
      allow read, write: if true;
    }
    // Явное разрешение для коллекции рынка
    match /market_v2/{agentId} {
      allow read, write: if true;
    }
  }
}