
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальный доступ для прототипа v13
    match /{allPaths=**} {
      allow read, write: if true;
    }
    
    match /players_v13/{userId} {
      allow read, write: if true;
    }

    match /matches_v2/{matchId} {
      allow read, write: if true;
    }
    
    match /league_tables_v2/{tableId} {
      allow read, write: if true;
    }
    
    match /global_chat_v2/{msgId} {
      allow read, write: if true;
    }
    
    match /friend_requests_v4/{reqId} {
      allow read, write: if true;
    }
    
    match /market_v7/{agentId} {
      allow read, write: if true;
    }
  }
}
