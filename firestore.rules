
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Moba Tactics Online Security Rules - V2
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /players_v2/{userId} {
      // Разрешаем чтение профиля владельцу
      allow get: if isOwner(userId);
      
      // Разрешаем листинг для поиска по названию команды и распределения по лигам
      allow list: if true; 
      
      // Создание и обновление: пользователь должен быть владельцем
      // Упрощаем правила для предотвращения ошибок при создании/обновлении через setDoc
      allow create, update: if isOwner(userId);
      
      // Удаление: только владелец
      allow delete: if isOwner(userId);
    }

    match /heroes/{heroId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /roles_admin/{userId} {
      allow get, list, create, update, delete: if false;
    }
  }
}
