
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальный доступ для прототипа v11
    match /{allPaths=**} {
      allow read, write: if true;
    }
    
    // Явные правила для критических коллекций v11
    match /players_v11/{userId} {
      allow read, write: if true;
    }
    
    match /global_chat_v2/{msgId} {
      allow read, write: if true;
    }
    
    match /friend_requests_v4/{reqId} {
      allow read, write: if true;
    }
    
    match /market_v7/{agentId} {
      allow read, write: if true;
    }
  }
}
