
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /players_v2/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /friendly_lobbies/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        request.auth.uid == resource.data.challengerId ||
        request.resource.data.status == 'challenged'
      );
    }

    match /global_chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /private_messages/{messageId} {
      // Allow reading if the user is one of the participants
      // list and get require the participants field to be a list and contain the UID
      allow read: if isSignedIn() && 
        "participants" in resource.data && 
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;
      
      // Allow creation if the sender is the authenticated user and is in participants
      allow create: if isSignedIn() && 
        request.resource.data.senderId == request.auth.uid &&
        "participants" in request.resource.data &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;
      
      // Allow updates (like marking as read) for participants
      allow update: if isSignedIn() && 
        "participants" in resource.data && 
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;
      
      allow delete: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
