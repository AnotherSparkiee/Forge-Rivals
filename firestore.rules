rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit rules for the market collection to ensure access
    match /market_v2/{agentId} {
      allow read, write: if true;
    }
    
    // Explicit rules for player profiles
    match /players_v5/{userId} {
      allow read, write: if true;
    }

    // Global fallback for development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}