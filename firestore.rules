rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL TRANSFER MARKET (SHARED)
    // Allows all authenticated users to see and bid on the same global players.
    match /market_v2/{agentId} {
      allow read, write: if request.auth != null;
    }

    // 2. PLAYER PROFILES (players_v5)
    // Required for seeing other managers and ranking tables.
    match /players_v5/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. FRIENDLY MATCHES & LOBBIES
    match /friendly_lobbies/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /friendly_lobbies {
      allow list: if request.auth != null;
    }

    // 4. CW BASKET MATCHMAKING
    match /cw_basket/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /cw_basket {
      allow list: if request.auth != null;
    }

    // 5. SOCIAL & CHATS
    match /global_chat/{messageId} {
      allow read, create: if request.auth != null;
    }

    match /private_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}