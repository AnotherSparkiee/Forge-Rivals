rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Абсолютно открытые правила для прототипирования
    // Разрешает чтение, запись и удаление всем авторизованным пользователям в любой коллекции
    match /{document=**} {
      allow read, write, delete: if request.auth != null;
    }

    // Явные правила для критических коллекций (на случай, если рекурсивный поиск не сработает в Studio)
    match /friend_requests_v1/{requestId} {
      allow read, write, delete: if request.auth != null;
    }
    
    match /market_v2/{agentId} {
      allow read, write, delete: if request.auth != null;
    }

    match /associations_v1/{assocId} {
      allow read, write, delete: if request.auth != null;
    }

    match /global_chat/{msgId} {
      allow read, write, delete: if request.auth != null;
    }
    
    match /private_messages/{msgId} {
      allow read, write, delete: if request.auth != null;
    }

    match /players_v5/{userId} {
      allow read, write, delete: if request.auth != null;
    }
  }
}