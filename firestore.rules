rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Глобальное разрешение для всех коллекций:
    // Любой авторизованный пользователь может выполнять любые операции.
    // Это гарантирует работу прототипа без ошибок Access Denied.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}