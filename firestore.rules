
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Root pointers for discovery
    match /players_v10/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
    }

    // League Hierarchy - Deep Nesting Support
    match /leagues/{leagueId}/divisions/{div}/groups/{group}/teams/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      
      // Sub-collections for Heroes, Staff, Fanclub, Tournaments
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // League Matches & Cups
    match /leagues/{leagueId}/divisions/{div}/groups/{group}/matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /leagues/{leagueId}/cups/{season}/matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Standard collections
    match /associations_v4/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /global_chat_v2/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{messageId} {
      allow read, write: if isSignedIn() && (request.auth.uid in resource.data.participants || request.auth.uid in request.resource.data.participants);
    }

    match /friend_requests_v4/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notifications_v7/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn();
    }
    
    match /market_v7/{docId} {
      allow read, write: if isSignedIn();
    }

    match /cw_basket_v2/{docId} {
      allow read, write: if isSignedIn();
    }

    match /friendly_lobbies_v3/{docId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
