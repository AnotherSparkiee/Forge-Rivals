
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Common check for private messages participants
    function isParticipant() {
      return isSignedIn() && (request.auth.uid in resource.data.get('participants', []));
    }

    match /players_v2/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /friendly_lobbies/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        request.auth.uid == resource.data.challengerId ||
        request.resource.data.status == 'challenged'
      );
    }

    match /global_chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /private_messages/{messageId} {
      // Allow reading if user is in the participants list
      allow read: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []));
      
      // Allow creation if the sender is the current user and includes themselves in participants
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.get('participants', []));
      
      // Allow updates (like marking as read) only for participants
      allow update: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []));
      
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
