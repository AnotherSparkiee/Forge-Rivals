rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === HELPERS ===
    function isSignedIn() {
      return request.auth != null;
    }

    // === DATA STRUCTURES ===

    // Профили игроков - разрешаем чтение и запись всем авторизованным для синхронизации мира
    match /players_v10/{userId} {
      allow read, write: if isSignedIn();
    }

    // Таблицы лиг - критически важно для AutoMatchManager
    match /league_tables_v1/{tableId} {
      allow read, write: if isSignedIn();
    }

    // Кубок Пирамиды
    match /cup_pyramid_v1/{cupId} {
      allow read, write: if isSignedIn();
    }

    match /cup_matches/{matchId} {
      allow read, write: if isSignedIn();
    }

    // Матчи
    match /matches_v1/{matchId} {
      allow read, write: if isSignedIn();
    }

    // Иерархия лиг - полный доступ для авторизованных (необходимо для управления ботами)
    match /leagues_v2/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Социальные функции и рынок
    match /global_chat_v2/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{msgId} {
      allow read, create, update: if isSignedIn() && (request.auth.uid in request.resource.data.participants || request.auth.uid in resource.data.participants);
    }

    match /market_v7/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /notifications_v7/{notifId} {
      allow read, write: if isSignedIn();
    }

    match /friendly_lobbies_v3/{lobbyId} {
      allow read, write: if isSignedIn();
    }

    match /cw_basket_v2/{entryId} {
      allow read, write: if isSignedIn();
    }
    
    match /friend_requests_v4/{reqId} {
      allow read, write: if isSignedIn();
    }
    
    // Системные коллекции
    match /system_v1/{docId} {
      allow read, write: if isSignedIn();
    }

    // Fallback
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}