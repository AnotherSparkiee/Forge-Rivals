
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Root profile (Pointers)
    match /players_v10/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // Pyramidal League Structure
    match /leagues_v2/{leagueId}/divisions/{divId}/groups/{groupId}/teams/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      
      match /heroes/{heroId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
      match /staff/{staffId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // Global Matches (READ ONLY for clients)
    // Results and schedules are managed by Cloud Functions Service Account
    match /matches_v1/{matchId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    // Communication & Social
    match /global_chat_v2/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /private_messages_v3/{msgId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
