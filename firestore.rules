
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // === ОСНОВНЫЕ ПРОФИЛИ (v10) ===
    match /players_v10/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['associationId', 'lastJoinedAssocAt', 'tournaments', 'tournamentHistory'])
      );
    }

    // === ГЛОБАЛЬНЫЕ МАТЧИ (v1) ===
    match /global_matches_v1/{matchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // === ТОВАРНЫЕ РЫНКИ (v7) ===
    match /market_v7/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid || 
        resource.data.highestBidderId == request.auth.uid ||
        resource.data.sellerId == 'system'
      );
    }

    // === ТОВАРИЩЕСКИЕ МАТЧИ (v3) ===
    match /friendly_lobbies_v3/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isSignedIn();
    }

    // === КОРЗИНА КВ (v2) ===
    match /cw_basket_v2/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isSignedIn();
    }

    // === ЧАТЫ ===
    match /global_chat_v2/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /private_messages_v3/{messageId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow delete: if false;
    }

    // === УВЕДОМЛЕНИЯ (v7) ===
    match /notifications_v7/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        request.auth.uid == 'system'
      );
    }

    // === ЗАЯВКИ В ДРУЗЬЯ (v4) ===
    match /friend_requests_v4/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.fromId == request.auth.uid || 
        resource.data.toId == request.auth.uid
      );
    }

    // === АССОЦИАЦИИ (v4) ===
    match /associations_v4/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.deputyId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'memberNames', 'membersData', 'news'])
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // === ВСЁ ОСТАЛЬНОЕ — ЗАПРЕЩЕНО ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
