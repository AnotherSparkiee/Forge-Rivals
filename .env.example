# Firebase Configuration
# Get these from Firebase Console -> Project Settings -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studio-2788872209-f7092.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studio-2788872209-f7092
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=680539014052
NEXT_PUBLIC_FIREBASE_APP_ID=1:680539014052:web:3fafccf090ba18376d7731

# Telegram Configuration
# Generate a strong random salt for deterministic password generation
NEXT_PUBLIC_TELEGRAM_SALT=your_secret_telegram_salt_here_min_32_chars
# Optional: Your Telegram Bot Token (if using Bot API)
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Firebase Admin SDK (Server-side only)
# Download from Firebase Console -> Service Account Key
FIREBASE_ADMIN_SDK_KEY={"type":"service_account",...}

# Environment
NODE_ENV=development
