
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a player's profile in the game, holding personal data, currency, and references to their owned heroes and teams.",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "inGameCurrency": { "type": "number" },
        "crystals": { "type": "number" },
        "experiencePoints": { "type": "number" },
        "lastLoginDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownedHeroIds": { "type": "array", "items": { "type": "string" } },
        "ownedHeroes": { "type": "array", "items": { "type": "object" } },
        "leagueLevel": { "type": "number" },
        "divisionSubId": { "type": "number" },
        "groupId": { "type": "number" },
        "country": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "tournaments": { "type": "array", "items": { "type": "string" } },
        "tournamentHistory": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "tournamentId": { "type": "string" },
              "tournamentName": { "type": "string" },
              "result": { "type": "string" },
              "startDate": { "type": "string", "format": "date-time" },
              "endDate": { "type": "string", "format": "date-time" },
              "status": { "type": "string", "enum": ["completed", "abandoned", "eliminated", "active"] }
            }
          }
        }
      },
      "required": ["id", "displayName", "email", "inGameCurrency", "experiencePoints", "lastLoginDate", "createdAt", "ownedHeroIds"]
    },
    "MarketAgent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketAgent",
      "type": "object",
      "description": "A free agent or player-listed auction item on the transfer market.",
      "properties": {
        "id": { "type": "string" },
        "heroData": { "type": "object" },
        "currentBid": { "type": "number" },
        "startingPrice": { "type": "number" },
        "highestBidderId": { "type": "string" },
        "highestBidderName": { "type": "string" },
        "bidders": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "dropDate": { "type": "string" },
        "dropTime": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/players_v5/{userId}",
        "definition": { "entityName": "UserProfile" }
      },
      {
        "path": "/market_v2/{agentId}",
        "definition": { "entityName": "MarketAgent" }
      }
    ]
  }
}
