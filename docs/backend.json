{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "inGameCurrency": { "type": "number" },
        "crystals": { "type": "number" },
        "experiencePoints": { "type": "number" },
        "lastLoginDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownedHeroIds": { "type": "array", "items": { "type": "string" } },
        "ownedHeroes": { "type": "array", "items": { "type": "object" } },
        "leagueLevel": { "type": "number" },
        "divisionSubId": { "type": "number" },
        "groupId": { "type": "number" },
        "country": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "tournaments": { "type": "array", "items": { "type": "string" } },
        "associationId": { "type": "string" }
      },
      "required": ["id", "displayName", "email", "inGameCurrency", "experiencePoints"]
    },
    "MarketAgent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketAgent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "heroData": { "type": "object" },
        "currentBid": { "type": "number" },
        "startingPrice": { "type": "number" },
        "highestBidderId": { "type": "string" },
        "highestBidderName": { "type": "string" },
        "bidders": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "dropDate": { "type": "string" },
        "dropTime": { "type": "string", "format": "date-time" }
      }
    },
    "FriendRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FriendRequest",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "toId": { "type": "string" },
        "toName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromId", "toId", "status"]
    },
    "Association": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/players_v5/{userId}",
        "definition": { "entityName": "UserProfile" }
      },
      {
        "path": "/market_v2/{agentId}",
        "definition": { "entityName": "MarketAgent" }
      },
      {
        "path": "/friend_requests_v1/{requestId}",
        "definition": { "entityName": "FriendRequest" }
      },
      {
        "path": "/associations_v1/{assocId}",
        "definition": { "entityName": "Association" }
      },
      {
        "path": "/global_chat/{msgId}",
        "definition": { "type": "object" }
      },
      {
        "path": "/private_messages/{msgId}",
        "definition": { "type": "object" }
      },
      {
        "path": "/friendly_lobbies/{lobbyId}",
        "definition": { "type": "object" }
      }
    ]
  }
}