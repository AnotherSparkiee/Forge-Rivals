
{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Root pointer for user location in the pyramid",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "leagueLevel": { "type": "number" },
        "groupId": { "type": "number" },
        "lastProcessedSeason": { "type": "number" },
        "setupDate": { "type": "string", "format": "date-time" }
      }
    },
    "LeagueGroup": {
      "title": "LeagueGroup",
      "description": "Synchronized state for a single group of 8 teams",
      "type": "object",
      "properties": {
        "seasonId": { "type": "number" },
        "roundNumber": { "type": "number" },
        "teams": { "type": "array" },
        "calendar": { "type": "array" },
        "lastProcessedDate": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/players_v10/{userId}": {
      "schema": "PlayerProfile",
      "description": "User account and location"
    },
    "/leagues_v2/{leagueId}/divisions/{divId}/groups/{groupId}": {
      "schema": "LeagueGroup",
      "description": "Autonomous group engine state"
    },
    "/matches_v1/{matchId}": {
      "schema": "Match",
      "description": "Historical record of all matches"
    }
  }
}
