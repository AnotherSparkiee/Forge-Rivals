
{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Основной профиль менеджера в системе v12 (Global Reset)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "clubName": { "type": "string" },
        "clubLogo": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "leagueLevel": { "type": "number" },
        "groupId": { "type": "number" },
        "rank": { "type": "number" },
        "country": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginDate": { "type": "string", "format": "date-time" },
        "version": { "type": "number" }
      }
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Зафиксированный результат матча лиги v12",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leagueId": { "type": "string" },
        "level": { "type": "number" },
        "groupId": { "type": "number" },
        "season": { "type": "number" },
        "tour": { "type": "number" },
        "homeId": { "type": "string" },
        "awayId": { "type": "string" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "winnerId": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "version": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "email"]
  },
  "firestore": {
    "/players_v12/{userId}": {
      "schema": "#/backend/entities/PlayerProfile",
      "description": "Глобальный реестр участников лиги v12"
    },
    "/matches_v1/{matchId}": {
      "schema": "#/backend/entities/MatchRecord",
      "description": "Архив зафиксированных результатов лиги v12"
    }
  }
}
