
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a player's profile in the game, holding personal data, currency, and references to their owned heroes and teams.",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "inGameCurrency": { "type": "number" },
        "experiencePoints": { "type": "number" },
        "lastLoginDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownedHeroIds": { "type": "array", "items": { "type": "string" } },
        "leagueLevel": { "type": "number" },
        "divisionSubId": { "type": "number" },
        "groupId": { "type": "number" },
        "country": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "tournaments": { "type": "array", "items": { "type": "string" } },
        "tournamentHistory": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "tournamentId": { "type": "string" },
              "tournamentName": { "type": "string" },
              "result": { "type": "string" },
              "startDate": { "type": "string", "format": "date-time" },
              "endDate": { "type": "string", "format": "date-time" },
              "status": { "type": "string", "enum": ["completed", "abandoned", "eliminated"] }
            }
          }
        }
      },
      "required": ["id", "displayName", "email", "inGameCurrency", "experiencePoints", "lastLoginDate", "createdAt", "ownedHeroIds"]
    },
    "FriendlyLobby": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FriendlyLobby",
      "type": "object",
      "description": "A temporary lobby for matchmaking friendly matches.",
      "properties": {
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "status": { "type": "string", "enum": ["searching", "challenged", "accepted", "rejected"] },
        "challengerId": { "type": "string" },
        "challengerName": { "type": "string" },
        "matchResult": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatMessage",
      "type": "object",
      "description": "A message sent in a chat room.",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text", "createdAt"]
    },
    "PrivateMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PrivateMessage",
      "type": "object",
      "description": "A secured transmission between two managers.",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "participants", "text", "createdAt", "read"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/players_v5/{userId}",
        "definition": { "entityName": "UserProfile" }
      },
      {
        "path": "/friendly_lobbies/{userId}",
        "definition": { "entityName": "FriendlyLobby" }
      },
      {
        "path": "/global_chat/{messageId}",
        "definition": { "entityName": "ChatMessage" }
      },
      {
        "path": "/private_messages/{messageId}",
        "definition": { "entityName": "PrivateMessage" }
      }
    ]
  }
}
