
{
  "entities": {
    "PlayerProfile": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "leagueId": { "type": "string" },
        "divisionLevel": { "type": "number" },
        "groupId": { "type": "number" },
        "inGameCurrency": { "type": "number" },
        "crystals": { "type": "number" },
        "ownedHeroes": { "type": "array" }
      }
    },
    "MatchRecord": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "season": { "type": "number" },
        "day": { "type": "number" },
        "homeId": { "type": "string" },
        "awayId": { "type": "string" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "winnerId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "players_v10/{userId}",
        "description": "Root pointer for player location (league, div, group)"
      },
      {
        "path": "leagues/{leagueId}/divisions/{divLevel}/groups/{groupId}/teams/{userId}",
        "definition": "PlayerProfile",
        "description": "Primary team data within a specific group"
      },
      {
        "path": "leagues/{leagueId}/cups/{seasonNumber}/matches/{matchId}",
        "definition": "MatchRecord",
        "description": "Pyramid Cup matches specific to a league"
      },
      {
        "path": "leagues/{leagueId}/divisions/{divLevel}/groups/{groupId}/matches/{matchId}",
        "definition": "MatchRecord",
        "description": "League matches within a specific group"
      }
    ]
  }
}
