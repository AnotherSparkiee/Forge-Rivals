
{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Root pointer for user location in the pyramid",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "leagueLevel": { "type": "number" },
        "groupId": { "type": "number" },
        "setupDate": { "type": "string", "format": "date-time" }
      }
    },
    "Team": {
      "title": "Team",
      "description": "Actual club data within a specific league group",
      "type": "object",
      "properties": {
        "credits": { "type": "number" },
        "crystals": { "type": "number" },
        "points": { "type": "number" },
        "wins": { "type": "number" },
        "draws": { "type": "number" },
        "losses": { "type": "number" },
        "strategy": { "type": "string" }
      }
    },
    "Match": {
      "title": "Match",
      "description": "Global match record managed by Cloud Functions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leagueId": { "type": "string" },
        "divisionId": { "type": "number" },
        "groupId": { "type": "number" },
        "startTime": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["league", "cup"] },
        "status": { "type": "string", "enum": ["pending", "live", "finished"] },
        "homeId": { "type": "string" },
        "awayId": { "type": "string" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "winnerId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "players_v11/{userId}",
        "definition": "PlayerProfile",
        "description": "User account pointers"
      },
      {
        "path": "leagues_v2/{leagueId}/divisions/{divId}/groups/{groupId}/teams/{userId}",
        "definition": "Team",
        "description": "Clubs within the pyramidal structure"
      },
      {
        "path": "matches_v1/{matchId}",
        "definition": "Match",
        "description": "Source of Truth for all scheduled engagements"
      }
    ]
  }
}
