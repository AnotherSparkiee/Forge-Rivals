
{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Основной профиль менеджера в системе v14 (Global Transition)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "clubName": { "type": "string" },
        "clubLogo": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "leagueLevel": { "type": "number" },
        "groupId": { "type": "number" },
        "rank": { "type": "number" },
        "country": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginDate": { "type": "string", "format": "date-time" },
        "version": { "type": "number" }
      }
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Зафиксированный результат матча лиги v140",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "leagueId": { "type": "string" },
        "level": { "type": "number" },
        "groupId": { "type": "number" },
        "season": { "type": "number" },
        "tour": { "type": "number" },
        "homeId": { "type": "string" },
        "awayId": { "type": "string" },
        "scoreA": { "type": "number" },
        "scoreB": { "type": "number" },
        "winnerId": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "version": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "email"]
  },
  "firestore": {
    "/players_v14/{userId}": {
      "schema": "#/backend/entities/PlayerProfile",
      "description": "Глобальный реестр участников лиги v14"
    },
    "/league_tables_v2/{tableId}": {
      "description": "Турнирные таблицы версии 140"
    },
    "/matches_v2/{matchId}": {
      "schema": "#/backend/entities/MatchRecord",
      "description": "Архив зафиксированных результатов лиги v140"
    }
  }
}
