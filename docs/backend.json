
{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Основной профиль менеджера в системе v11",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "clubName": { "type": "string" },
        "selectedLeagueId": { "type": "string" },
        "leagueLevel": { "type": "number" },
        "groupId": { "type": "number" },
        "rank": { "type": "number" },
        "country": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "version": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "email"]
  },
  "firestore": {
    "/players_v11/{userId}": {
      "schema": "#/backend/entities/PlayerProfile",
      "description": "Глобальный реестр участников лиги v11"
    }
  }
}
