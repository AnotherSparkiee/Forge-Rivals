        "definition": "PlayerProfile"
      },
      {
        "path": "private_messages_v3/{msgId}",
        "definition": "PlayerProfile"
      },
      {
        "path": "friendly_lobbies_v3/{lobbyId}",
        "definition": "PlayerProfile"
      },
      {
        "path": "cw_basket_v2/{userId}",
